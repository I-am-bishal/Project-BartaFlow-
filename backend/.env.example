# BartaFlow Backend Configuration

# Server Port
PORT=5000

# OpenAI API Key (Required for Chatbot AI)
OPENAI_API_KEY=your_openai_key_here

# Meta WhatsApp Business API
WHATSAPP_TOKEN=your_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_id

# Security
JWT_SECRET=super_secret_key_for_admin_login
